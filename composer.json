{
    "name": "student/ci-cd-lab",
    "description": "Minimal PHP project for CI/CD testing",
    "type": "project",
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "laravel/pint": "^1.13"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests/Unit",
        "lint": "pint --test",
        "format": "pint",
        "ci": [
            "@lint",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}

